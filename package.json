    "name": "Laurynas Karvelis <Explosive Brains Ltd>",
    "email": "hello@zeroad.network",
    "url": "http://zeroad.network"
  },
  "keywords": [
    "zero ad network",
    "zero-ad-network",
    "zeroad",
    "better-web",
    "publisher",
    "monetization",
    "ad-free",
    "paywall",
    "subscription",
    "membership",
    "entitlement",
    "content-access",
    "sdk",
    "token",
    "token-verification",
    "verify",
    "signature",
    "http-header",
    "offline-verification",
    "ed25519",
    "eddsa",
    "webcrypto",
    "privacy",
    "hostname-binding",
    "middleware",
    "node",
    "nodejs",
    "bun",
    "deno",
    "edge",
    "cloudflare-workers",
    "serverless",
    "aws",
    "aws-lambda",
    "lambda-edge",
    "google-cloud",
    "google-cloud-functions",
    "cloud-run",
    "esm",
    "cjs",
    "express",
    "fastify",
    "hono",
    "nextjs",
    "nuxt",
    "sveltekit"
  ],
  "engines": {
    "node": ">=16.0.0",
    "bun": ">=1.1.0",
    "deno": ">=2.0.0"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.cjs",
    "dist/*.d.ts",
    "SKILLS.md"
  ],
  "scripts": {
    "prettier": "prettier . --write",
    "build:esm": "bun build ./src/index.ts --outfile ./dist/index.mjs --target=node --format=esm",
    "build:cjs": "bun build ./src/index.ts --outfile ./dist/index.cjs --target=node --format=cjs",
    "build:types": "tsc --emitDeclarationOnly",
    "build": "rm -rf ./dist && bun run build:esm && bun run build:cjs && bun run build:types",
    "test": "bun test ./src",
    "test:smoke": "bun run build && node smoke-tests/import.mjs && node smoke-tests/require.cjs",
    "lint:fix": "biome check . --write",
    "lint": "biome check ."
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "biome": "0.3.3",
    "typescript": "7.0.2"
  },
  "description": "Offline verification of Zero Ad Network subscriber tokens for publisher backends. Zero dependencies."
}
